  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "RandomUtils = class {",
          "  constructor() {}",
          "  getLocationArea() {",
          "    return {",
          "      name: pm.variables.replaceIn('loc-{{$randomWord}}-{{$randomInt}}'),",
          "      type: 'OTHER',",
          "      lat: 55.751244,",
          "      lon: 37.618423,",
          "      radiusKm: 5.0",
          "    };",
          "  }",
          "  getLocationAreaPatch() {",
          "    return {",
          "      name: pm.variables.replaceIn('loc-upd-{{$randomWord}}-{{$randomInt}}'),",
          "      type: 'PARK',",
          "      radiusKm: 7.5",
          "    };",
          "  }",
          "};",
          ""
        ],
        "packages": {}
      }
