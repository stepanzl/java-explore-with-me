  "item": [
    {
      "name": "Admin: locations",
      "item": [
        {
          "name": "Create location (POST /admin/locations)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const rnd = new RandomUtils();",
                  "const loc = rnd.getLocationArea();",
                  "pm.collectionVariables.set('locationName', loc.name);",
                  "pm.variables.set('locBody', JSON.stringify(loc));"
                ],
                "packages": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "try {",
                  "  const json = pm.response.json();",
                  "  if (json && json.id !== undefined && json.id !== null) {",
                  "    pm.collectionVariables.set('locationId', String(json.id));",
                  "  }",
                  "} catch (e) {",
                  "  // ignore",
                  "}"
                ],
                "packages": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{locBody}}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/locations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "locations"
              ]
            }
          },
          "response": []
        },
